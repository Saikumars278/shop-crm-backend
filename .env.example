# Database Configuration (PostgreSQL / Supabase or SQLite fallback)
# Either DATABASE_URL or individual DB_* variables:
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=your_database_password
DB_HOST=aws-1-eu-central-1.pooler.supabase.com
DB_PORT=5432

# Razorpay Credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Brevo SMTP Email Credentials
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
